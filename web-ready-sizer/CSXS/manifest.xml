<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="9.0"
                   ExtensionBundleId="com.webready.sizer"
                   ExtensionBundleVersion="1.0.0"
                   ExtensionBundleName="Web-Ready Sizer"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <ExtensionList>
        <Extension Id="com.webready.sizer.panel" Version="1.0.0" />
    </ExtensionList>
    <ExecutionEnvironment>
        <HostList>
            <Host Name="ILST" Version="[24.0,27.9]" />
        </HostList>
        <LocaleList>
            <Locale Code="All" />
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="10.0" />
        </RequiredRuntimeList>
    </ExecutionEnvironment>
    <DispatchInfoList>
        <Extension Id="com.webready.sizer.panel">
            <DispatchInfo>
                <Resources>
                    <MainPath>./client/index.html</MainPath>
                    <ScriptPath>./jsx/host.jsx</ScriptPath>
                    <CEFCommandLine>
                        <Parameter>--allow-file-access</Parameter>
                        <Parameter>--allow-file-access-from-files</Parameter>
                        <Parameter>--disable-web-security</Parameter>
                    </CEFCommandLine>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>Web-Ready Sizer</Menu>
                    <Geometry>
                        <Size>
                            <Height>700</Height>
                            <Width>400</Width>
                        </Size>
                        <MinSize>
                            <Height>480</Height>
                            <Width>340</Width>
                        </MinSize>
                        <MaxSize>
                            <Height>1400</Height>
                            <Width>620</Width>
                        </MaxSize>
                    </Geometry>
                    <Icons />
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>
